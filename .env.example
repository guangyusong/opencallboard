# The frontend never consumes provider secrets. Configure optional server-side adapters
# only through Wrangler secrets and bindings; keep real destinations allowlisted.

# Cloudflare Worker operator settings. Configure as Wrangler variables/secrets, never
# as VITE_ variables. Shared D1 writes require an authenticated organizer session.
CALLBOARD_WRITE_ENABLED=false
CALLBOARD_BOOTSTRAP_SECRET=

# Binding name configured in wrangler.toml after a D1 database is explicitly created:
# CALLBOARD_DB
