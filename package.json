{
  "name": "opencallboard",
  "version": "0.2.0",
  "description": "Open-source event content operations with Sessionboard-faithful workflows.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "npm@11.6.2",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prepare-sites-build.mjs",
    "preview": "vite preview",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "verify:sites": "npm run build && npm run test:sites",
    "release:preflight": "node scripts/release-preflight.mjs",
    "release:prepare": "npm run verify:sites && npm run release:preflight",
    "cloudflare:dev": "npm run build && wrangler dev --env preview --local --port 8788",
    "cloudflare:check": "npm run build && node scripts/cloudflare-preflight.mjs",
    "cloudflare:whoami": "wrangler whoami",
    "cloudflare:deploy:preview": "npm run cloudflare:check && node scripts/cloudflare-deploy.mjs",
    "cloudflare:readback:preview": "node scripts/cloudflare-readback.mjs",
    "cloudflare:rollback:preview": "node scripts/cloudflare-rollback.mjs"
  },
  "dependencies": {
    "@fontsource/montserrat": "^5.1.1",
    "@vitejs/plugin-react": "5.0.4",
    "lucide-react": "^0.468.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "vite": "6.4.3"
  },
  "devDependencies": {
    "wrangler": "4.120.0"
  }
}
